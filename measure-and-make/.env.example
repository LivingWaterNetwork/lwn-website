# Measure & Make — environment
#
# Nothing here is optional theatre: with the Airtable values unset, the contact
# form tells the visitor plainly that it cannot deliver and points them at the
# contact email instead of showing a success state.

# Airtable destination for contact submissions.
# Base: "Measure & Make" -> table: "Inquiries".
# The token needs data.records:write on this base only.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appKznUQ11agoIbcs
AIRTABLE_TABLE_ID=tblgc13tluLMgJHgo

# Optional second notification path to the same inbox. The Airtable base
# already has an automation that emails new inquiries, so these are only needed
# if you also want the site itself to send one.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=info@lwnetwork.org

# Optional. A shared Airtable form link for the same Inquiries table, shown on
# the contact page as an alternative to the on-site form. Airtable form views
# cannot be created through the API, so paste a real share link here once one
# exists — leave it empty and no link renders.
NEXT_PUBLIC_AIRTABLE_FORM_URL=
