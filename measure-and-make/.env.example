# Measure & Make — environment
#
# One credential is required for the contact form to save anything. Without it
# the form does not pretend to work: it tells the visitor plainly that nothing
# was sent and nothing was saved.

# ---------------------------------------------------------------------------
# REQUIRED: Airtable personal access token (server-side only)
# ---------------------------------------------------------------------------
# Create at https://airtable.com/create/tokens
#   Scope:  data.records:write   (data.records:read is not needed)
#   Access: the "Measure & Make" base only
# Set it in the deployment environment as a secret. Never commit a real value,
# and never expose it to the browser: it is read only in src/lib/airtable.ts,
# which is server-only, and there is no NEXT_PUBLIC_ variant of it.
AIRTABLE_API_KEY=

# Destination base and table. These are not secrets; they are already correct.
AIRTABLE_BASE_ID=appKznUQ11agoIbcs
AIRTABLE_TABLE_ID=tblgc13tluLMgJHgo
