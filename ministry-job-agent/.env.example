# Local SQLite database. Relative paths resolve from ./prisma, so ../data
# places the file at ./data/ministry-agent.db. This file is gitignored.
DATABASE_URL="file:../data/ministry-agent.db"

# Optional: point Playwright at a specific Chromium binary.
# PLAYWRIGHT_CHROMIUM_PATH="/opt/pw-browsers/chromium"

# NEVER put candidate personal information in this file or in .env.
# Candidate data belongs in the local database, entered and approved through
# the dashboard. See CLAUDE.md, rule 10.
