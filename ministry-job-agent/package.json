{
  "name": "ministry-job-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Ministry Job Agent — discovery, research, scoring, and human-gated application preparation for church and Christian ministry positions.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset",
    "setup": "prisma generate && prisma db push && tsx scripts/seed-real.ts",
    "seed:real": "tsx scripts/seed-real.ts",
    "seed:fixtures": "tsx scripts/seed-fixtures.ts",
    "discover": "tsx scripts/discover.ts",
    "score": "tsx scripts/score.ts",
    "report": "tsx scripts/report.ts",
    "import": "tsx scripts/import-sources.ts",
    "apply:assist": "tsx browser/run-assist.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "mammoth": "^1.12.1",
    "next": "14.2.35",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.39",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
