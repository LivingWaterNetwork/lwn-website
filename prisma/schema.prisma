generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  source    String   @default("website")
  createdAt DateTime @default(now())

  @@map("leads")
}

model CohortApplication {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  city        String?
  state       String?
  role        String?
  ministry    String?
  whyJoin     String
  referral    String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@map("cohort_applications")
}

model Donation {
  id                   String    @id @default(cuid())
  stripePaymentId      String    @unique
  stripeCustomerId     String?
  amount               Int       // in cents
  currency             String    @default("usd")
  frequency            String    // one-time | monthly | yearly
  name                 String?
  email                String
  comment              String?
  status               String    @default("pending")
  receiptSent          Boolean   @default(false)
  thankYouLetterSentAt DateTime?
  createdAt            DateTime  @default(now())

  @@map("donations")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

model ProgramInquiry {
  id        String   @id @default(cuid())
  program   String   // counseling | mentorship | speaking | missions | coaching | church-advisory
  name      String
  email     String
  phone     String?
  details   String   // main free-text field, covers tailored per-program questions
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@map("program_inquiries")
}

model PartnershipInquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  organization String?
  tier         String?  // Cornerstone Partner | Kingdom Builder | Formation Fellow | Community Sustainer | Not sure yet
  message      String?
  status       String   @default("new")
  createdAt    DateTime @default(now())

  @@map("partnership_inquiries")
}

model MultiYearPledgeInquiry {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String?
  organization    String?
  pledgeLength    String?  // 3 years | 4 years | 5 years
  estimatedAnnual String?
  message         String?
  status          String   @default("new")
  createdAt       DateTime @default(now())

  @@map("multi_year_pledge_inquiries")
}

// ---------------------------------------------------------------------------
// YAN Atlanta — content + submission models for the /yan mini-site.
// Namespaced with a Yan* prefix and yan_ table names so they stay clearly
// separated from the core LWN models above. All backward-compatible
// additions — no existing model/table is touched.
// ---------------------------------------------------------------------------

model YanGroup {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  description        String
  city               String   @default("Atlanta") // city slug label, e.g. "Atlanta" | "New York City" | "Los Angeles"
  neighborhood       String?
  meetingDay         String?
  meetingFrequency   String?
  ageRangeMin        Int?
  ageRangeMax        Int?
  churchAffiliation  String?
  gatheringType      String? // in-person | hybrid | online
  accessibilityNotes String?
  websiteUrl         String?
  instagramHandle    String?
  contactEmail       String?
  leaderName         String?
  featured           Boolean  @default(false)
  verified           Boolean  @default(false)
  status             String   @default("pending") // pending | published | archived
  submittedByEmail   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("yan_groups")
}

model YanLeader {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  role             String?
  ministryName     String?
  bio              String
  photoUrl         String?
  quote            String?
  city             String   @default("Atlanta") // "Atlanta" | "New York City" | "Los Angeles" | "Phoenix"
  featured         Boolean  @default(false)
  status           String   @default("pending") // pending | published | archived
  consentGiven     Boolean  @default(false)
  submittedByEmail String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("yan_leaders")
}

model YanEvent {
  id              String                 @id @default(cuid())
  title           String
  slug            String                 @unique
  eventType       String // roundtable | prayer-gathering | worship-night | service-project | training | resource-exchange
  city            String                 @default("Atlanta") // "Atlanta" | "New York City" | "Los Angeles" | "Phoenix"
  summary         String
  description     String?
  startsAt        DateTime?
  endsAt          DateTime?
  timezone        String                 @default("America/New_York")
  venueName       String?
  venueAddress    String?
  capacity        Int?
  waitlistEnabled Boolean                @default(true)
  audience        String?
  status          String                 @default("draft") // draft | coming-soon | published | past | cancelled
  featured        Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  registrations   YanEventRegistration[]

  @@map("yan_events")
}

model YanEventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  event        YanEvent @relation(fields: [eventId], references: [id])
  name         String
  email        String
  phone        String?
  role         String? // pastor | ministry-leader | volunteer | other
  organization String?
  status       String   @default("registered") // registered | waitlisted | cancelled
  createdAt    DateTime @default(now())

  @@index([eventId])
  @@map("yan_event_registrations")
}

model YanResource {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  resourceType     String // leader-tool | curriculum | prayer-guide | event-kit | reading | training | opportunity
  description      String
  fileUrl          String?
  externalUrl      String?
  city             String   @default("Atlanta") // "Atlanta" | "New York City" | "Los Angeles" | "Phoenix"
  featured         Boolean  @default(false)
  status           String   @default("pending") // pending | published | archived
  submittedByEmail String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("yan_resources")
}

model YanStory {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  storyType        String // testimony | movement-moment | event-recap | collaboration
  body             String
  authorName       String?
  mediaUrl         String?
  city             String   @default("Atlanta") // "Atlanta" | "New York City" | "Los Angeles" | "Phoenix"
  consentGiven     Boolean  @default(false)
  status           String   @default("pending") // pending | published | archived
  submittedByEmail String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("yan_stories")
}

model YanPrayerTheme {
  id           String   @id @default(cuid())
  title        String
  body         String
  scriptureRef String?
  city         String   @default("Atlanta") // "Atlanta" | "New York City" | "Los Angeles" | "Phoenix"
  status       String   @default("draft") // draft | published | archived
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("yan_prayer_themes")
}

model YanPrayerRequest {
  id            String   @id @default(cuid())
  requestText   String
  name          String?
  email         String?
  city          String? // city page the request was submitted from, if known — requests aren't city-gated
  visibility    String   @default("private") // private | anonymous-public
  allowFollowUp Boolean  @default(false)
  status        String   @default("new") // new | reviewed | published | archived
  createdAt     DateTime @default(now())

  @@map("yan_prayer_requests")
}

model YanJoinSubmission {
  id           String   @id @default(cuid())
  pathway      String // ministry-leader | pastor | roundtable-interest | find-community | partner-volunteer | updates
  name         String
  email        String
  phone        String?
  ministryName String?
  city         String?
  role         String?
  message      String?
  status       String   @default("new")
  createdAt    DateTime @default(now())

  @@map("yan_join_submissions")
}

model YanSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  interests String? // comma-separated pathway interests
  createdAt DateTime @default(now())

  @@map("yan_subscribers")
}

// ---------------------------------------------------------------------------
// Business Stewardship Discovery — a personalized business-discovery form
// used ahead of strategy calls. clientSlug identifies which personalized
// version the submission came from (e.g. "dante"); answers holds the full
// structured response so the shape can evolve per-client without migrations.
// ---------------------------------------------------------------------------

model BusinessStewardshipDiscovery {
  id         String   @id @default(cuid())
  clientSlug String // which personalized discovery this came from, e.g. "dante"
  name       String
  email      String
  phone      String?
  answers    Json
  status     String   @default("new")
  createdAt  DateTime @default(now())

  @@map("business_stewardship_discoveries")
}

// ---------------------------------------------------------------------------
// LWN Agreements — private, reusable e-signature portal (/agreements/<slug>).
// Template-driven so every future LWN agreement reuses the same machinery:
// a published AgreementTemplate version is immutable (contentSha256 pins it),
// an Agreement is one rendered, frozen instance of a template for one person
// or engagement, AgreementSigner rows track each party's signature, and
// AgreementEvent is an append-only audit log. Signed PDFs live in Postgres
// (AgreementDocument) through the existing DATABASE_URL — no new storage
// service or ORM.
// ---------------------------------------------------------------------------

model AgreementTemplate {
  id          String   @id @default(cuid())
  key         String // e.g. "lwn-coaching-business-launch"
  version     String // semver, e.g. "1.0.0"
  title       String
  body        String // markdown with {{variables}} and {{system:*}} tokens
  variablesSchema Json // JSON schema describing expected variables
  signerRoles Json // ordered list of { role, label, requiredBeforeSend? }
  requiredInitials Json // list of section labels requiring an inline initial
  contentSha256 String // sha256 of `body`, frozen once published — guards against editing a published version in place
  status      String   @default("draft") // draft | published | retired
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agreements  Agreement[]

  @@unique([key, version])
  @@map("agreement_templates")
}

model Agreement {
  id             String   @id @default(uuid())
  slug           String   @unique // "<name>-<8 random hex>", never derived in a reversible way
  templateId     String
  template       AgreementTemplate @relation(fields: [templateId], references: [id])
  variables      Json // the filled-in {{variable}} values, including derived ones (e.g. rendered installment table)
  renderedBody   String? // frozen markdown snapshot, set when status moves to "ready"
  contentSha256  String? // sha256 of renderedBody, frozen alongside it
  status         String   @default("draft")
  // draft -> ready -> sent -> viewed -> partially_signed -> executed | voided | expired
  accessCodeHash String? // scrypt hash of the 8-char access code; the code itself is never stored
  codeAttempts   Int      @default(0)
  lockedUntil    DateTime?
  expiresAt      DateTime?
  paymentUrl     String?
  isTest         Boolean  @default(false)
  voidedReason   String?
  voidedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  signers    AgreementSigner[]
  events     AgreementEvent[]
  documents  AgreementDocument[]

  @@map("agreements")
}

model AgreementSigner {
  id              String   @id @default(cuid())
  agreementId     String
  agreement       Agreement @relation(fields: [agreementId], references: [id])
  role            String // partner | participant | organization
  order           Int
  name            String
  email           String
  title           String?
  status          String   @default("pending") // pending | signed
  signedAt        DateTime?
  typedName       String?
  signatureImage  String? // data: PNG, optional drawn signature
  initials        Json? // { [sectionLabel]: true }
  ip              String?
  userAgent       String?
  consentVersion  String?

  @@index([agreementId])
  @@map("agreement_signers")
}

model AgreementEvent {
  id          String   @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  type        String // created | sent | code_failed | opened | consented | initialed | signed | countersigned | downloaded | voided | regenerated_code | extended
  actorRole   String? // partner | participant | organization | admin | system
  detail      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([agreementId])
  @@map("agreement_events")
}

model AgreementDocument {
  id          String   @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  kind        String // draft | participant_signed | executed
  version     Int      @default(1)
  sha256      String
  bytes       Bytes
  createdAt   DateTime @default(now())

  @@index([agreementId])
  @@map("agreement_documents")
}

// ---------------------------------------------------------------------------
// LWN Member Portal (/portal) — Phase 1. A private, template-driven space
// where members see their journey/sessions/steps/documents/payments and
// coaches run every program from one dashboard. All tables are prefixed
// portal_ and created by the additive-only `scripts/portal-migrate.ts`
// runner, never by `prisma db push` — see AGENTS.md "Member portal" section.
//
// portal_enrollments.agreementId and portal_documents.agreementDocumentId
// are plain scalar foreign keys into the existing agreements /
// agreement_documents tables (DB-level FK added by the migration script,
// not a Prisma relation() here) — deliberately not touching the Agreement /
// AgreementDocument models above. An agreement is immutable once ready and
// voided-then-recreated rather than edited in place, so these links are
// admin-set and re-linkable, never assumed to track a single agreement for
// the life of an enrollment.
// ---------------------------------------------------------------------------

model PortalPerson {
  id        String    @id @default(cuid())
  email     String    @unique // always stored lowercased
  firstName String
  lastName  String
  phone     String?
  isTest    Boolean   @default(false)
  status    String    @default("active") // active | archived
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("portal_persons")
}

model PortalStaffRole {
  id         String    @id @default(cuid())
  personId   String
  role       String // coach | admin
  grantedBy  String // personId of the admin who granted it
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([personId])
  @@map("portal_staff_roles")
}

model PortalPartnerOrg {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "mmg"
  name      String
  createdAt DateTime @default(now())

  @@map("portal_partner_orgs")
}

model PortalPartnerUser {
  id            String    @id @default(cuid())
  personId      String
  partnerOrgId  String
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([personId])
  @@index([partnerOrgId])
  @@map("portal_partner_users")
}

model PortalLoginChallenge {
  id             String    @id @default(cuid())
  emailHash      String // HMAC-SHA256(PORTAL_SESSION_SECRET, lowercased email)
  codeHash       String // HMAC-SHA256(PORTAL_SESSION_SECRET, 6-digit code)
  linkTokenHash  String // HMAC-SHA256(PORTAL_SESSION_SECRET, magic-link token)
  expiresAt      DateTime
  attempts       Int       @default(0)
  usedAt         DateTime?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  @@index([emailHash])
  @@map("portal_login_challenges")
}

model PortalLoginThrottle {
  id          String    @id @default(cuid())
  key         String    @unique // emailHash or ip, scoped by caller
  windowStart DateTime
  count       Int       @default(0)
  lockedUntil DateTime?

  @@map("portal_login_throttle")
}

model PortalSession {
  id                 String    @id @default(cuid())
  tokenHash          String    @unique // HMAC-SHA256(PORTAL_SESSION_SECRET, raw token) — keyed so rotating the secret invalidates every row
  personId           String
  activeEnrollmentId String?
  expiresAt          DateTime
  lastSeenAt         DateTime  @default(now())
  revokedAt          DateTime?
  ip                 String?
  userAgent          String?
  createdAt          DateTime  @default(now())

  @@index([personId])
  @@map("portal_sessions")
}

model PortalProgramTemplate {
  id          String    @id @default(cuid())
  key         String // e.g. "lwn-coaching-business-launch-60"
  version     String // semver
  title       String
  body        Json // phases, expected sessions, default steps/documents, module switches — see content/programs/<key>/<version>.json
  status      String    @default("draft") // draft | published | retired
  sha256      String // sha256 of `body`, frozen once published — immutability mirrors AgreementTemplate
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([key, version])
  @@map("portal_program_templates")
}

model PortalEnrollment {
  id               String    @id @default(cuid())
  personId         String
  templateId       String
  templateSnapshot Json // copy of the template body at enrollment time
  coachPersonId    String?
  status           String    @default("draft") // draft | invited | active | paused | completed | archived
  startDate        DateTime?
  endDate          DateTime?
  currentPhaseKey  String?
  modules          Json // module switches for this enrollment, subset of MODULES_AVAILABLE
  agreementId      String? // scalar FK into agreements.id — admin-set, re-linkable, not a Prisma relation (see note above)
  paymentUrl       String?
  invitedAt        DateTime?
  archivedAt       DateTime?
  isTest           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([personId])
  @@index([coachPersonId])
  @@map("portal_enrollments")
}

model PortalPhase {
  id           String   @id @default(cuid())
  enrollmentId String
  key          String // e.g. "see" | "sit" | "send"
  title        String
  startsOn     DateTime?
  endsOn       DateTime?
  summary      String
  order        Int

  @@index([enrollmentId])
  @@map("portal_phases")
}

model PortalMeeting {
  id                 String    @id @default(cuid())
  enrollmentId       String
  scheduledAt        DateTime?
  durationMin        Int       @default(60)
  format             String    @default("zoom") // zoom | phone | in_person
  status             String    @default("scheduled") // scheduled | held | rescheduled | canceled_by_coach | late_cancel | missed
  countsTowardTotal  Boolean   @default(true)
  sharedRecap        String? // markdown, member-visible
  recapSharedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([enrollmentId])
  @@map("portal_meetings")
}

// Deliberately its own table — never joined by any member or partner query —
// so a private coach note can never leak through a shared code path.
model PortalMeetingPrivateNote {
  id             String   @id @default(cuid())
  meetingId      String
  enrollmentId   String
  authorPersonId String
  body           String
  createdAt      DateTime @default(now())

  @@index([meetingId])
  @@index([enrollmentId])
  @@map("portal_meeting_private_notes")
}

model PortalActionStep {
  id           String    @id @default(cuid())
  enrollmentId String
  meetingId    String?
  phaseKey     String?
  title        String
  detail       String?
  dueOn        DateTime?
  status       String    @default("open") // open | done
  doneAt       DateTime?
  memberNote   String? // plain text, ≤500 chars, enforced in code
  tags         String[]  @default([])
  order        Int       @default(0)
  createdBy    String // personId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([enrollmentId])
  @@map("portal_action_steps")
}

model PortalDocument {
  id                  String   @id @default(cuid())
  enrollmentId        String? // null = program library (shared, not member-owned)
  templateKey         String?
  kind                String // agreement | worksheet | curriculum | brand_website | other
  title               String
  filename            String
  mime                String
  size                Int
  sha256              String
  agreementDocumentId String? // scalar FK into agreement_documents.id — see note above
  uploadedBy          String // personId
  visibleToMember     Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@index([enrollmentId])
  @@map("portal_documents")
}

model PortalDocumentBlob {
  id         String @id @default(cuid())
  documentId String @unique
  bytes      Bytes

  @@map("portal_document_blobs")
}

model PortalInstallment {
  id           String    @id @default(cuid())
  enrollmentId String
  label        String
  dueOn        DateTime
  amountCents  Int
  status       String    @default("due") // due | paid | adjusted | waived
  paidOn       DateTime?
  note         String?
  markedBy     String? // personId

  @@index([enrollmentId])
  @@map("portal_installments")
}

model PortalPartnerGrant {
  id               String    @id @default(cuid())
  enrollmentId     String
  partnerOrgId     String
  modules          Json // Phase 1 allows only ["brand_website"]
  grantedByPersonId String
  grantedVia       String // member | coach_with_consent
  grantedAt        DateTime  @default(now())
  revokedAt        DateTime?

  @@index([enrollmentId])
  @@index([partnerOrgId])
  @@map("portal_partner_grants")
}

// Append-only. meta never holds codes, tokens, notes, recaps, or financial
// details — only enough to say what happened (mirrors AgreementEvent).
model PortalEvent {
  id            String   @id @default(cuid())
  at            DateTime @default(now())
  actorPersonId String?
  actorRole     String // member | coach | admin | partner | system
  action        String
  subjectType   String
  subjectId     String
  enrollmentId  String?
  ip            String?
  userAgent     String?
  meta          Json?

  @@index([enrollmentId])
  @@index([subjectType, subjectId])
  @@map("portal_events")
}

model GalaSponsorshipInquiry {
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String?
  organization     String?
  sponsorshipLevel String?  // Presenting Table $10,000 | Gold Table $5,000 | Silver Table $2,500 | Individual Ticket(s) | Not sure yet
  ticketCount      String?
  message          String?
  status           String   @default("new")
  createdAt        DateTime @default(now())

  @@map("gala_sponsorship_inquiries")
}
