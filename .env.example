# ─── Database (Neon or Supabase Postgres) ───────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lwnetwork?sslmode=require"

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Obtain from: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
# Address to receive internal notifications (cohort applications, contact forms)
NOTIFY_EMAIL="info@lwnetwork.org"

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://lwnetwork.org"
# For local dev, use: http://localhost:3000

# ─── Cron protection ──────────────────────────────────────────────────────────
# Protects /api/cron/* routes from public abuse. Generate any random string
# (e.g. `openssl rand -hex 32`) and set the SAME value in Vercel's env vars —
# Vercel's cron invoker automatically sends it as `Authorization: Bearer <value>`.
CRON_SECRET="generate-a-random-string"

# Note: the donation thank-you-letter cron (src/app/api/cron/send-thank-you-letters)
# reuses the existing Microsoft Graph credentials below (MS_TENANT_ID/MS_CLIENT_ID/
# MS_CLIENT_SECRET) to send as ofandino@lwnetwork.org — no new Graph app setup
# needed, since the "LWN Website Mailer" app's Mail.Send permission is tenant-wide.
# Just confirm ofandino@lwnetwork.org is a real mailbox in the same M365 tenant.

# ─── LWN Agreements (/agreements) ────────────────────────────────────────────
# Password for the agreements admin dashboard (/agreements/admin). Omar sets
# this directly in Vercel — never commit or print its value. Until it's set,
# the admin login route returns a clear "ask Omar to set it" error instead of
# a confusing 401.
AGREEMENTS_ADMIN_PASSWORD="generate-a-random-password"
# Optional: a separate secret for signing agreement session cookies (both the
# per-agreement signer session and the admin session). Falls back to
# AGREEMENTS_ADMIN_PASSWORD if unset, same as the YAN admin pattern — set this
# if you ever want to rotate the admin password without invalidating the
# signing-secret derivation, or vice versa.
# AGREEMENTS_SESSION_SECRET="generate-a-different-random-string"

# ─── IndexNow (optional — faster Bing/Yandex indexing) ───────────────────────
# Not a secret — it's a verification token hosted publicly at /<key>.txt.
# A default key is already baked in (see src/lib/indexnow.ts and the matching
# public/<key>.txt file), so this is only needed if you rotate the key.
# INDEXNOW_KEY="31cc5b82785171cc67aa59f6b7e0761a"
